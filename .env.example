# Copy this file to .env and fill in real values before running the app.

DATABASE_URL="mysql://user:password@host:3306/calmatrip"

# NextAuth — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (Google sign-in disabled until these are set)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails auto-promoted to ADMIN on sign-in
ADMIN_EMAILS=""

# Web Push — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="mailto:contact@example.com"

# SMTP — required for booking confirmation emails
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Your Site <contact@example.com>"

# Twilio WhatsApp — optional
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
