{
  "name": "calmatrip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/db-start.cjs",
    "dev": "next dev",
    "prebuild": "node scripts/db-start.cjs",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "db:start": "node scripts/db-start.cjs",
    "db:stop": "node scripts/db-stop.cjs",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/db-start.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
