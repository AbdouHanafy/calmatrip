generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  phone          String?
  password       String?
  role           String    @default("USER")
  status         String    @default("active")
  b2bType        String?
  b2bStatus      String?   @default("pending")
  commissionRate Float     @default(10)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  sessions       Session[]

  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  products          Product[]
  services          Service[]
  exploreListings   ExploreListing[]
  communityPosts    CommunityPost[]
  favorites         Favorite[]
  partnerProfile    PartnerProfile?

  @@map("users")
}

// Richer B2B onboarding/application record. User.role / b2bType / b2bStatus
// remain the authoritative fields for access control (middleware, session
// callback); this model is the detailed wizard data + review lifecycle that
// feeds them, and doubles as the resumable draft (status starts at DRAFT).
model PartnerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  partnerType String // "ARTISAN" | "AGENCY"
  status      String @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | SUSPENDED
  currentStep Int    @default(1)

  organizationName String?
  contactFirstName String?
  contactLastName  String?
  phone            String?

  countryCode String?
  city        String?
  currency    String?
  website     String?

  rejectionReason String?   @db.Text
  submittedAt     DateTime?
  reviewedAt      DateTime?

  interests      PartnerInterest[]
  socialProfiles PartnerSocialProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partner_profiles")
}

model PartnerInterest {
  id        Int            @id @default(autoincrement())
  profileId String
  profile   PartnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category  String

  @@unique([profileId, category])
  @@map("partner_interests")
}

model PartnerSocialProfile {
  id        Int            @id @default(autoincrement())
  profileId String
  profile   PartnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  String
  url       String

  @@unique([profileId, platform])
  @@map("partner_social_profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_idx")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_idx")
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Service {
  id               Int           @id @default(autoincrement())
  title            String
  subtitle         String?
  description      String        @db.Text
  price            String
  icon             String        @default("Car")
  color            String?
  category         String?
  features         Json?
  duration         String?
  image            String?       @db.Text
  active           Boolean       @default(true)
  popular          Boolean       @default(false)
  order            Int           @default(0)
  ownerId          String?
  owner            User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  submissionStatus String        @default("approved")
  rejectionReason  String?       @db.Text
  destinations     Destination[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([ownerId])
  @@map("services")
}

model ExploreListing {
  id               Int      @id @default(autoincrement())
  title            String
  description      String   @db.Text
  category         String
  image            String?  @db.Text
  city             String
  address          String?
  price            String?
  budget           Int      @default(2)
  duration         String?
  openingHours     String?
  capacity         Int?
  lat              Float?
  lng              Float?
  active           Boolean  @default(true)
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  submissionStatus String   @default("pending")
  rejectionReason  String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
  @@map("explore_listings")
}

model Booking {
  id              Int       @id @default(autoincrement())
  service         String
  date            DateTime
  time            String
  fromLocation    String
  toLocation      String
  status          String    @default("pending")
  // Manually set by an admin once payment is received — Calma Trip has no
  // online payment gateway (cash / bank transfer on arrival), so this is a
  // real, admin-controlled field, not a stand-in for actual payment processing.
  paymentStatus   String    @default("pending")
  price           String?
  driver          String?
  vehicle         String?
  passengers      Int       @default(1)
  specialRequests String?   @db.Text
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  timeSlotId      Int?
  timeSlot        TimeSlot? @relation(fields: [timeSlotId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  hasLuggage      Boolean   @default(false)

  tripType   String    @default("one-way")
  returnDate DateTime?
  returnTime String?

  // Snapshotted at booking time when the service belongs to a B2B partner —
  // lets us track what the platform earned without recomputing from
  // service/user records that may change later.
  serviceId        Int?
  ownerId          String?
  commissionRate   Float?
  commissionAmount Float?

  review Review?

  @@index([timeSlotId])
  @@map("bookings")
}

model TimeSlot {
  id        Int       @id @default(autoincrement())
  serviceId Int
  date      DateTime
  time      String
  capacity  Int       @default(5)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([serviceId, date, time])
  @@map("time_slots")
}

model Product {
  id               Int         @id @default(autoincrement())
  name             String
  price            Float
  category         String
  image            String?
  description      String      @db.Text
  stock            Int         @default(100)
  sizes            Json?
  ownerId          String?
  owner            User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  submissionStatus String      @default("approved")
  rejectionReason  String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]

  @@index([ownerId])
  @@map("products")
}

model TeamMember {
  id         Int    @id @default(autoincrement())
  name       String
  role       String
  experience String
  icon       String
  gradient   String
  order      Int    @default(0)

  @@map("team_members")
}

model Destination {
  id          Int       @id @default(autoincrement())
  name        String
  emoji       String    @default("")
  description String
  order       Int       @default(0)
  // Only active destinations are offered in the public search bar.
  active      Boolean   @default(true)
  // Services explicitly tied to this destination. A service with no
  // destination at all is treated as available everywhere.
  services    Service[]

  @@map("destinations")
}

model FAQ {
  id       Int    @id @default(autoincrement())
  question String @db.Text
  answer   String @db.Text
  icon     String
  order    Int    @default(0)

  @@map("faqs")
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  description String    @db.Text
  image       String?   @db.Text
  city        String
  address     String?
  startDate   DateTime
  endDate     DateTime?
  price       String?
  category    String?
  lat         Float?
  lng         Float?
  active      Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("events")
}

model Museum {
  id           Int      @id @default(autoincrement())
  name         String
  description  String   @db.Text
  image        String?  @db.Text
  city         String
  address      String?
  openingHours String?
  price        String?
  lat          Float?
  lng          Float?
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("museums")
}

model PracticalGuide {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  summary   String   @db.Text
  content   String   @db.Text
  category  String?
  icon      String?
  image     String?  @db.Text
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("practical_guides")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  itemType  String // "product" | "place" | "event" | "museum" | "service"
  itemId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@map("favorites")
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Order {
  id            Int         @id @default(autoincrement())
  customerName  String
  customerEmail String
  customerPhone String?
  address       String
  city          String?
  total         Float
  status        String      @default("pending")
  paymentMethod String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  price       Float
  quantity    Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  // Snapshotted at order time when the product belongs to a B2B partner.
  ownerId          String?
  commissionRate   Float?
  commissionAmount Float?

  @@index([orderId], map: "order_items_orderId_idx")
  @@index([productId], map: "order_items_productId_idx")
  @@map("order_items")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contacts")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    String?
  recipient String
  type      String
  title     String
  body      String    @db.Text
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recipient, isRead])
  @@index([userId])
  @@index([isRead, readAt]) // utile pour le cleanup
  @@map("notifications")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String?
  role      String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([userId])
  @@map("push_subscriptions")
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  avatar    String?
  rating    Int
  comment   String   @db.Text
  service   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  bookingId Int?     @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("reviews")
}

model CommunityPost {
  id           Int      @id @default(autoincrement())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName   String
  authorAvatar String?
  content      String   @db.Text
  image        String?  @db.Text
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([authorId])
  @@map("community_posts")
}

// ---------------------------------------------------------------------------
// Extensible CMS. These additive models deliberately do not replace any of
// the strongly typed booking, commerce, user, or partner models above.
// Administrator-defined values are validated by the CMS service before they
// are stored in JSON columns.
// ---------------------------------------------------------------------------

model ContentType {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?           @db.Text
  icon              String?
  listColumns       Json?
  defaultSort       Json?
  publishingEnabled Boolean           @default(true)
  localized         Boolean           @default(true)
  active            Boolean           @default(true)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  fields            FieldDefinition[]
  entries           ContentEntry[]

  @@map("cms_content_types")
}

model FieldDefinition {
  id            String      @id @default(cuid())
  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  key           String
  label         String
  type          String
  required      Boolean     @default(false)
  unique        Boolean     @default(false)
  localized     Boolean     @default(false)
  searchable    Boolean     @default(false)
  sortable      Boolean     @default(false)
  position      Int         @default(0)
  placeholder   Json?
  helpText      Json?
  defaultValue  Json?
  validation    Json?
  options       Json?
  visibility    Json?
  relation      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([contentTypeId, key])
  @@index([contentTypeId, position])
  @@map("cms_field_definitions")
}

model ContentEntry {
  id            String      @id @default(cuid())
  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)
  slug          String
  status        String      @default("DRAFT")
  locale        String      @default("fr")
  data          Json
  seo           Json?
  createdBy     String?
  updatedBy     String?
  publishedBy   String?
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([contentTypeId, slug, locale])
  @@index([contentTypeId, status, updatedAt])
  @@index([slug, locale, status])
  @@map("cms_content_entries")
}

model CmsPage {
  id              String              @id @default(cuid())
  title           String
  slug            String
  locale          String              @default("fr")
  status          String              @default("DRAFT")
  seo             Json?
  createdBy       String?
  updatedBy       String?
  publishedBy     String?
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  blocks          CmsPageBlock[]
  navigationItems CmsNavigationItem[]

  @@unique([slug, locale])
  @@index([status, locale, updatedAt])
  @@map("cms_pages")
}

model CmsPageBlock {
  id        String   @id @default(cuid())
  pageId    String
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, position])
  @@map("cms_page_blocks")
}

model FormDefinition {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description Json?
  status      String           @default("DRAFT")
  settings    Json?
  createdBy   String?
  updatedBy   String?
  publishedBy String?
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  steps       FormStep[]
  submissions FormSubmission[]

  @@index([status, updatedAt])
  @@map("cms_form_definitions")
}

model FormStep {
  id          String         @id @default(cuid())
  formId      String
  form        FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  title       Json
  description Json?
  position    Int            @default(0)
  condition   Json?
  fields      FormField[]

  @@index([formId, position])
  @@map("cms_form_steps")
}

model FormField {
  id           String   @id @default(cuid())
  stepId       String
  step         FormStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  key          String
  label        Json
  type         String
  required     Boolean  @default(false)
  position     Int      @default(0)
  placeholder  Json?
  helpText     Json?
  defaultValue Json?
  validation   Json?
  options      Json?
  condition    Json?

  @@unique([stepId, key])
  @@index([stepId, position])
  @@map("cms_form_fields")
}

model FormSubmission {
  id          String         @id @default(cuid())
  formId      String
  form        FormDefinition @relation(fields: [formId], references: [id], onDelete: Restrict)
  status      String         @default("NEW")
  locale      String         @default("fr")
  data        Json
  notes       Json?
  assignedTo  String?
  submitterId String?
  draftToken  String?        @unique
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([formId, status, createdAt])
  @@map("cms_form_submissions")
}

model CmsMedia {
  id          String   @id @default(cuid())
  filename    String
  publicId    String?  @unique
  url         String   @db.Text
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  title       String?
  alt         Json?
  caption     Json?
  description Json?
  folder      String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mimeType, createdAt])
  @@map("cms_media")
}

model CmsMediaFolder {
  id        String   @id @default(cuid())
  name      String   @unique
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_media_folders")
}

model CmsNavigation {
  id          String              @id @default(cuid())
  name        String
  key         String              @unique
  status      String              @default("DRAFT")
  createdBy   String?
  updatedBy   String?
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       CmsNavigationItem[]

  @@map("cms_navigations")
}

model CmsNavigationItem {
  id           String              @id @default(cuid())
  navigationId String
  navigation   CmsNavigation       @relation(fields: [navigationId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       CmsNavigationItem?  @relation("NavigationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     CmsNavigationItem[] @relation("NavigationTree")
  pageId       String?
  page         CmsPage?            @relation(fields: [pageId], references: [id], onDelete: SetNull)
  label        Json
  url          String
  type         String              @default("INTERNAL")
  target       String              @default("_self")
  visible      Boolean             @default(true)
  position     Int                 @default(0)

  @@index([navigationId, parentId, position])
  @@index([pageId])
  @@map("cms_navigation_items")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("cms_site_settings")
}

model CmsRedirect {
  id          String   @id @default(cuid())
  source      String   @unique
  destination String
  statusCode  Int      @default(301)
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@map("cms_redirects")
}

model CmsRevision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  version    Int
  snapshot   Json
  actorId    String?
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
  @@map("cms_revisions")
}

model CmsAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("cms_audit_logs")
}
