generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  status        String    @default("active")
  b2bType       String?
  b2bStatus     String?   @default("pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  products          Product[]
  services          Service[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_idx")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_idx")
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Service {
  id               Int      @id @default(autoincrement())
  title            String
  subtitle         String?
  description      String   @db.Text
  price            String
  icon             String   @default("Car")
  color            String?
  category         String?
  features         Json?
  duration         String?
  image            String?  @db.Text
  active           Boolean  @default(true)
  popular          Boolean  @default(false)
  order            Int      @default(0)
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  submissionStatus String   @default("approved")
  rejectionReason  String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
  @@map("services")
}

model Booking {
  id              Int       @id @default(autoincrement())
  service         String
  date            DateTime
  time            String
  fromLocation    String
  toLocation      String
  status          String    @default("pending")
  price           String?
  driver          String?
  vehicle         String?
  passengers      Int       @default(1)
  specialRequests String?   @db.Text
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  timeSlotId      Int?
  timeSlot        TimeSlot? @relation(fields: [timeSlotId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  hasLuggage      Boolean   @default(false)

  tripType    String   @default("one-way")
  returnDate  DateTime?
  returnTime  String?

  review Review?

  @@index([timeSlotId])
  @@map("bookings")
}

model TimeSlot {
  id        Int       @id @default(autoincrement())
  serviceId Int
  date      DateTime
  time      String
  capacity  Int       @default(5)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([serviceId, date, time])
  @@map("time_slots")
}

model Product {
  id               Int         @id @default(autoincrement())
  name             String
  price            Float
  category         String
  image            String?
  description      String      @db.Text
  stock            Int         @default(100)
  sizes            Json?
  ownerId          String?
  owner            User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  submissionStatus String      @default("approved")
  rejectionReason  String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]

  @@index([ownerId])
  @@map("products")
}

model TeamMember {
  id         Int    @id @default(autoincrement())
  name       String
  role       String
  experience String
  icon       String
  gradient   String
  order      Int    @default(0)

  @@map("team_members")
}

model Destination {
  id          Int    @id @default(autoincrement())
  name        String
  emoji       String
  description String
  order       Int    @default(0)

  @@map("destinations")
}

model FAQ {
  id       Int    @id @default(autoincrement())
  question String @db.Text
  answer   String @db.Text
  icon     String
  order    Int    @default(0)

  @@map("faqs")
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Order {
  id            Int         @id @default(autoincrement())
  customerName  String
  customerEmail String
  customerPhone String?
  address       String
  city          String?
  total         Float
  status        String      @default("pending")
  paymentMethod String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  price       Float
  quantity    Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "order_items_orderId_idx")
  @@index([productId], map: "order_items_productId_idx")
  @@map("order_items")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contacts")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String?
  recipient String
  type      String
  title     String
  body      String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recipient, isRead])
  @@index([userId])
  @@index([isRead, readAt]) // utile pour le cleanup
  @@map("notifications")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String?
  role      String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([userId])
  @@map("push_subscriptions")
}
model Review {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  avatar    String?
  rating    Int
  comment   String   @db.Text
  service   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  bookingId Int?     @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("reviews")
}